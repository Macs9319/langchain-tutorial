OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Tutorial 27: logins. The demo accounts (sam@, dana@, staff@example.com)
# are created at startup with this password (12+ characters). Leave it unset
# for a real deployment and create accounts with 27_auth.py --add-user.
# PEDALWISE_DEMO_PASSWORD=
# Optional: a token for scripts that call the staff API (24+ characters):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# STAFF_TOKEN=

# Other providers (Tutorial 23). Models are "provider:model".
# DEEPSEEK_API_KEY=
# CHAT_MODEL=deepseek:deepseek-flash      # every tutorial's model (default: OPENAI_MODEL)
# FALLBACK_MODEL=openai:gpt-5-nano        # or none
# EMBEDDINGS=openai                       # none: keyword search only, no OpenAI key needed
# DEEPSEEK_THINKING=false

# Tutorial 30: alerts. Where to post them (a Slack incoming webhook, or
# anything that accepts {"text": ...}), and a URL to ping after every round of
# checks, so an outside service notices if the checker itself stops.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_HEARTBEAT_URL=https://hc-ping.com/your-check-id
# ALERT_APP_URL=http://127.0.0.1:8001     # set by compose for the container
